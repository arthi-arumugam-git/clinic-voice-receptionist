# Required for browser / Daily / Twilio voice. Copy to .env, never commit .env.
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=
# Choose a voice from your Cartesia dashboard.
CARTESIA_VOICE_ID=

# Optional voice/model overrides
TTS_PROVIDER=cartesia
OPENAI_MODEL=gpt-4o-mini
DEEPGRAM_MODEL=nova-3-general
CARTESIA_MODEL=sonic-3.6
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# Optional Daily rooms: pip install -e '.[daily]'
DAILY_API_KEY=

# Twilio phone mode and/or SMS notification
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Required for server.py phone mode: public HTTPS origin, no path/trailing slash.
# Example: https://your-tunnel.ngrok-free.app
PUBLIC_BASE_URL=

# Optional clinic staff notifications. Blank = channel skipped.
CLINIC_NOTIFY_PHONE=
CLINIC_NOTIFY_EMAIL=
# SMTP uses TLS by default. Set SMTP_SECURITY=ssl for port 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls
# Email uses Resend when both RESEND_API_KEY and RESEND_FROM_EMAIL are set;
# otherwise SMTP. Resend sender must be on a verified domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# false sends counts + call reference only; true includes personal demo details.
NOTIFY_INCLUDE_DETAILS=false

# Local demo data
CLINIC_CONFIG_PATH=clinic_config.yaml
DATABASE_PATH=data/clinic.sqlite3
MAX_CALL_SECONDS=600
LOG_LEVEL=WARNING

# Clinic profile (alternative to CLINIC_CONFIG_PATH)
# Available profiles: dubai (Asia/Dubai timezone, AED currency, UAE emergency numbers)
# CLINIC_PROFILE=dubai

# Calendar integration (optional - falls back to local-only booking)
# Set CALENDAR_PROVIDER=mock to force mock mode regardless of other settings.
CALENDAR_PROVIDER=

# Google Calendar integration
# Requires a Google Cloud service account with Calendar API enabled.
# GOOGLE_CALENDAR_ID=primary
# GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service-account.json
# Or use an OAuth access token for short-lived auth:
# GOOGLE_CALENDAR_ACCESS_TOKEN=

# Cal.com integration
# Get your API key from https://app.cal.com/settings/developer/api-keys
# CALCOM_API_KEY=
# CALCOM_EVENT_TYPE_ID=
# CALCOM_API_URL=https://api.cal.com/v1
